# Docker Compose variables. Copy to .env: cp .env.example .env
# On Linux set UID/GID to the output of `id -u` and `id -g`.
UID=1000
GID=1000

# 127.0.0.1 = this machine only, 0.0.0.0 = reachable from the local network (physical phone)
API_BIND=127.0.0.1
API_PORT=8000

POSTGRES_DB=lokum
POSTGRES_USER=lokum
POSTGRES_PASSWORD=lokum
POSTGRES_PORT=5432

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# off | debug | coverage | develop (can be combined: debug,coverage)
XDEBUG_MODE=off
